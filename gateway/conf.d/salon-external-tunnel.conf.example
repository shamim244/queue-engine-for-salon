# ==============================================================================
# UNIVERSAL CLOUDFLARE TUNNEL ROUTER (Backend & Frontend Unified)
# Copy this file to /etc/nginx/conf.d/salon-external-tunnel.conf on the VPS.
# ==============================================================================
map $server_port $tunnel_backend {
    # Backend Tunnel Slots (Ports 3003 - 3006)
    default api1.nexgentech.site;
    3003 api1.nexgentech.site;
    3004 api2.nexgentech.site;
    3005 api3.nexgentech.site;
    3006 api4.nexgentech.site;

    # Frontend Next.js Tunnel Slots (Ports 3007 - 3010)
    3007 web1.nexgentech.site;
    3008 web2.nexgentech.site;
    3009 web3.nexgentech.site;
    3010 web4.nexgentech.site;
}

server {
    # Pre-opened tunnel ports (Backend: 3003-3006 | Frontend: 3007-3010)
    listen 127.0.0.1:3003;
    listen 127.0.0.1:3004;
    listen 127.0.0.1:3005;
    listen 127.0.0.1:3006;
    listen 127.0.0.1:3007;
    listen 127.0.0.1:3008;
    listen 127.0.0.1:3009;
    listen 127.0.0.1:3010;
    server_name _;

    # Disable IPv6 to prevent AWS EC2 AAAA lookup timeouts
    resolver 1.1.1.1 8.8.8.8 ipv6=off valid=300s;
    resolver_timeout 5s;

    # Set proxy headers at server level to guarantee Host header inheritance during failovers
    proxy_ssl_server_name on;
    proxy_ssl_name $tunnel_backend;
    proxy_set_header Host $tunnel_backend;
    proxy_set_header X-Real-IP $client_ip;
    proxy_set_header CF-Connecting-IP $http_cf_connecting_ip;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto https;

    location / {
        proxy_pass https://$tunnel_backend;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";

        proxy_read_timeout 86400s;
        proxy_send_timeout 86400s;
    }
}
