# External Cloudflare Tunnel Backend Bridge (Example)
# Copy this file to /etc/nginx/conf.d/salon-external-tunnel.conf on the VPS.
# This bridges plain HTTP from the Nginx upstream cluster to an external HTTPS Cloudflare Tunnel.

server {
    listen 127.0.0.1:3003;
    server_name _;

    # Public DNS resolver for dynamic Cloudflare IP resolution
    resolver 1.1.1.1 8.8.8.8 valid=300s;
    resolver_timeout 5s;

    location / {
        proxy_pass https://api1.nexgentech.site;
        proxy_ssl_server_name on;
        proxy_ssl_name api1.nexgentech.site;
        proxy_set_header Host api1.nexgentech.site;

        # Real Client IP forwarding
        proxy_set_header X-Real-IP $client_ip;
        proxy_set_header CF-Connecting-IP $http_cf_connecting_ip;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;

        # WebSocket support
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";

        proxy_read_timeout 86400s;
        proxy_send_timeout 86400s;
    }
}
