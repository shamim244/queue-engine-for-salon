# ==============================================================================
# UNIVERSAL CLOUDFLARE TUNNEL ROUTER (Zero-Conflict Port Segregation)
# 3000 Series (3003 - 3010) -> Dedicated to Backend API Tunnels
# 4000 Series (4001 - 4010) -> Dedicated to Frontend Next.js Tunnels
# Copy this file to /etc/nginx/conf.d/salon-external-tunnel.conf on the VPS.
# ==============================================================================
map $server_port $tunnel_backend {
    # --- BACKEND API TUNNEL SLOTS (3000 Series) ---
    default api1.nexgentech.site;
    3003 api1.nexgentech.site;
    3004 api2.nexgentech.site;
    3005 api3.nexgentech.site;
    3006 api4.nexgentech.site;
    3007 api5.nexgentech.site;
    3008 api6.nexgentech.site;
    3009 api7.nexgentech.site;
    3010 api8.nexgentech.site;

    # --- FRONTEND NEXT.JS TUNNEL SLOTS (4000 Series) ---
    4001 web1.nexgentech.site;
    4002 web2.nexgentech.site;
    4003 web3.nexgentech.site;
    4004 web4.nexgentech.site;
    4005 web5.nexgentech.site;
    4006 web6.nexgentech.site;
    4007 web7.nexgentech.site;
    4008 web8.nexgentech.site;
    4009 web9.nexgentech.site;
    4010 web10.nexgentech.site;
}

server {
    # Pre-opened Backend tunnel ports (3000 Series)
    listen 127.0.0.1:3003;
    listen 127.0.0.1:3004;
    listen 127.0.0.1:3005;
    listen 127.0.0.1:3006;
    listen 127.0.0.1:3007;
    listen 127.0.0.1:3008;
    listen 127.0.0.1:3009;
    listen 127.0.0.1:3010;

    # Pre-opened Frontend tunnel ports (4000 Series)
    listen 127.0.0.1:4001;
    listen 127.0.0.1:4002;
    listen 127.0.0.1:4003;
    listen 127.0.0.1:4004;
    listen 127.0.0.1:4005;
    listen 127.0.0.1:4006;
    listen 127.0.0.1:4007;
    listen 127.0.0.1:4008;
    listen 127.0.0.1:4009;
    listen 127.0.0.1:4010;

    server_name _;

    # Disable IPv6 to prevent AWS EC2 AAAA lookup timeouts
    resolver 1.1.1.1 8.8.8.8 ipv6=off valid=300s;
    resolver_timeout 5s;

    # Set proxy headers at server level to guarantee Host header inheritance during failovers
    proxy_ssl_server_name on;
    proxy_ssl_name $tunnel_backend;
    proxy_set_header Host $tunnel_backend;
    proxy_set_header X-Real-IP $client_ip;
    proxy_set_header CF-Connecting-IP $http_cf_connecting_ip;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto https;

    location / {
        proxy_pass https://$tunnel_backend;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";

        proxy_read_timeout 86400s;
        proxy_send_timeout 86400s;
    }
}
