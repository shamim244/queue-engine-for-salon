# Upstream worker nodes for salon_frontend_cluster
# Copy this file to /etc/nginx/conf.d/salon-frontend-nodes.inc on the VPS.
# This file is decoupled from git tracking to allow dynamic server-side frontend node scaling.

server 127.0.0.1:3000 max_fails=1 fail_timeout=10s;
# server 127.0.0.1:3007; # Scenario 1: External Frontend via Cloudflare Tunnel
# server 10.0.1.50:3000; # Scenario 2: External VPS Frontend on Static IP
# server 127.0.0.1:3008; # Scenario 3: Local Second Next.js Worker on same VPS
