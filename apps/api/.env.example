# Elysia / Bun Server Configuration
PORT=3001
HOST=0.0.0.0
NODE_ENV=development

# MySQL 8.0 Database Configuration
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password_here
DB_NAME=engine_que_salon

# Authentication & Session Security
JWT_SECRET=your_jwt_secret_key_here

# WhatsApp Business / Notification Configuration
WHATSAPP_MOCK_MODE=true
WHATSAPP_API_KEY=
WHATSAPP_PHONE_NUMBER_ID=

# Currency and Localization
DEFAULT_CURRENCY=INR
DEFAULT_COUNTRY_CODE=+91

# CORS Allowed Origins (comma-separated)
CORS_ALLOWED_ORIGINS=https://web.nexgentech.site,http://web.nexgentech.site,https://nexgentech.site,http://localhost:3000

# Payment Gateway (Razorpay / Cashfree)
RAZORPAY_KEY_ID=rzp_test_mock
RAZORPAY_KEY_SECRET=secret_mock

# Redis Distributed Cache & Pub/Sub (Optional - In-Memory Fallback active if omitted)
REDIS_URL=redis://127.0.0.1:6379
