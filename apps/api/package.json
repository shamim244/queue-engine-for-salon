{
  "name": "@engine-que/api",
  "version": "1.0.0",
  "module": "index.ts",
  "type": "module",
  "private": true,
  "scripts": {
    "start": "bun index.ts",
    "dev": "bun --watch index.ts",
    "build": "bun build index.ts --outdir dist --target bun",
    "db:migrate": "bun src/db/cli.ts migrate",
    "db:status": "bun src/db/cli.ts status",
    "db:fresh": "bun src/db/cli.ts fresh",
    "db:seed": "bun src/db/cli.ts seed",
    "db:rollback": "bun src/db/cli.ts rollback",
    "db:reset": "bun src/db/cli.ts reset",
    "test": "bun test --parallel=1"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/ioredis": "^5.0.0"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "dependencies": {
    "@elysiajs/cors": "^1.4.2",
    "@elysiajs/static": "^1.4.10",
    "@elysiajs/swagger": "^1.3.1",
    "@mongodb-js/zstd": "^7.0.0",
    "elysia": "^1.4.30",
    "fzstd": "^0.1.1",
    "ioredis": "^6.0.0",
    "mysql2": "^3.24.4",
    "zstd-codec": "^0.1.5"
  }
}
