# Next.js Web App Environment Configuration

# ------------------------------------------------------------------------------
# LOCAL DEVELOPMENT MODE (Default: local Bun backend on port 3001)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_WS_URL=ws://localhost:3001/ws
INTERNAL_API_URL=http://localhost:3001

# ------------------------------------------------------------------------------
# HYBRID MODE (Local Next.js connecting to AWS EC2 Production Backend Grid)
# Uncomment the block below if you want your local frontend to hit EC2 directly:
# ------------------------------------------------------------------------------
# NEXT_PUBLIC_API_URL=http://65.2.127.88:8000
# NEXT_PUBLIC_WS_URL=ws://65.2.127.88:8000/ws
# INTERNAL_API_URL=http://65.2.127.88:8000
