# Next.js Web App Environment Configuration

# Public API Gateway URL (accessed by browser clients)
NEXT_PUBLIC_API_URL=http://localhost:3001

# Public WebSocket Endpoint (for real-time live queue and appointment sync)
NEXT_PUBLIC_WS_URL=ws://localhost:3001/ws

# Internal Server-to-Server API URL (optional for Docker/Kubernetes container networks)
INTERNAL_API_URL=http://localhost:3001
