{
  "name": "engine-que-monorepo",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "bun --filter \"*\" dev",
    "dev:api": "cd apps/api && bun index.ts",
    "dev:web": "cd apps/web && bun run dev",
    "test": "bun test --parallel=1",
    "db:migrate": "cd apps/api && bun src/db/cli.ts migrate",
    "db:status": "cd apps/api && bun src/db/cli.ts status",
    "db:fresh": "cd apps/api && bun src/db/cli.ts fresh",
    "db:seed": "cd apps/api && bun src/db/cli.ts seed",
    "db:rollback": "cd apps/api && bun src/db/cli.ts rollback",
    "db:reset": "cd apps/api && bun src/db/cli.ts reset",
    "build:backend": "cd apps/api && bun run build",
    "build:frontend": "cd apps/web && bun run build",
    "build:web": "bun run build:frontend",
    "build": "bun run build:backend && bun run build:frontend",
    "env:check": "bun scripts/validate-env.ts",
    "pm2:start": "pm2 start ecosystem.config.cjs",
    "pm2:stop": "pm2 stop ecosystem.config.cjs",
    "pm2:restart": "pm2 restart ecosystem.config.cjs",
    "pm2:status": "pm2 status",
    "pm2:logs": "pm2 logs"
  },
  "workspaces": [
    "apps/*"
  ]
}
