{
  "name": "engine-que-monorepo",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "bun --filter \"*\" dev",
    "dev:api": "cd apps/api && bun index.ts",
    "dev:web": "cd apps/web && bun run dev",
    "test": "bun test --parallel=1",
    "build:web": "cd apps/web && bun run build",
    "build": "bun run build:web"
  }
}
